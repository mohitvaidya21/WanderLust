<% layout("/layouts/boilerplate.ejs") %>
<body>
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">

        <div class="card border-0 shadow-lg text-center p-5" style="max-width: 600px; border-radius: 1.5rem;">

            <div>
                <h1 style="font-size: 6rem; color: #fe424d; font-weight: 700;">
                    <%= err.statusCode %>
                </h1>
            </div>

            <h2 class="mb-3" style="font-weight: 600;">
                Oops! Something went wrong
            </h2>

            <p class="text-muted fs-5 mb-4">
                <%= err.message %>
            </p>

            <div>
                <a href="/listings" class="btn btn-danger px-4 py-2 rounded-4">
                    Back to Home
                </a>
            </div>

        </div>

    </div>
</body>
